# Path where the saved Naukri browser session lives
NAUKRI_STATE_FILE=state.json

# Optional Telegram alerts (leave blank to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Random delay before running, in minutes (0 = none)
MAX_RANDOM_DELAY_MIN=30

# Retries for update+verify
MAX_ATTEMPTS=3

# Set to 0 to watch the browser while debugging
HEADLESS=1
