# Path where the saved Naukri browser session lives
NAUKRI_STATE_FILE=state.json

# Optional Telegram alerts (leave blank to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Random delay before running, in minutes (0 = none)
MAX_RANDOM_DELAY_MIN=30

# Retries for update+verify
MAX_ATTEMPTS=3

# Set to 0 to watch the browser while debugging
HEADLESS=1

# Which browser Playwright drives:
#   chrome  = real installed Google Chrome (recommended, hardest to detect)
#   msedge  = real installed Microsoft Edge
#   bundled = Playwright's own Chromium (easiest for Naukri's bot detection)
BROWSER_CHANNEL=chrome

# Safety guard: bot refuses to edit if the profile name doesn't contain this
EXPECTED_NAME_CONTAINS=Chetan

# loop.py only: minutes between runs
INTERVAL_MINUTES=5

# loop.py only: stop after this many failed runs in a row
MAX_CONSECUTIVE_FAILS=3
